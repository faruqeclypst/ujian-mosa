node_modules
dist
.env
.env.*
.backup*
.backup *
.vscode
.DS_Store

# ── KEBOCORAN (fix 2026-10-01) ───────────────────────────────
# Signing key JANGAN pernah di-commit.
keystore/
*.jks
*.keystore
release-key.*
*.pem
license_private_key.*

# Folder backup lokal (bukan template tenant).
/backup pocketbase/
/backup-pb/

# CATATAN: JANGAN pakai pola global *.db / pb_data/ — akan memblokir
# vps/template_school/pb_data/data.db yang DIBUTUHKAN setup-school.sh
# untuk provisioning tenant baru.

# File testing sementara (lokal, jangan commit)
# (folder scratch/ dikecualikan dari rule ini — berisi arsip skrip
#  sekali-pakai yang memang diniatkan masuk repo sebagai referensi)
scratch/tmp/
scratch/*.log

# APK binaries
*.apk
public/*.apk

# Offline and raw packaging assets
offline_package/
dist-shell/
assets-raw/
